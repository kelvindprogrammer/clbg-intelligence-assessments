{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DS-T2-012 view spec",
  "description": "One file per view of the explorable. It records the question the view answers and the evidence behind it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "audience_task", "encoding", "interaction", "data_sources", "uncertainty", "alt_text", "assumptions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "question": {"type": "string", "minLength": 15, "description": "The plain-language question this view answers for the reader."},
    "audience_task": {"type": "string", "minLength": 15, "description": "What the reader should be able to do or decide after using the view."},
    "encoding": {
      "type": "object",
      "required": ["mark", "x", "y"],
      "properties": {
        "mark": {"enum": ["bar", "line", "area", "point", "dot", "text", "table", "slider-readout"]},
        "x": {"type": "string"},
        "y": {"type": "string"},
        "color": {"type": "string"},
        "zero_baseline": {"type": "boolean"}
      }
    },
    "interaction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control", "variable", "range"],
        "properties": {
          "control": {"enum": ["slider", "select", "toggle", "button", "input"]},
          "variable": {"type": "string"},
          "range": {"type": "string"},
          "default": {}
        }
      }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "accessed", "licence"],
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "url": {"type": "string", "pattern": "^https?://"},
          "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "licence": {"type": "string", "minLength": 2}
        }
      }
    },
    "uncertainty": {"type": "string", "minLength": 20, "description": "How the view shows, or states, what is uncertain or assumed."},
    "alt_text": {"type": "string", "minLength": 120, "description": "A text alternative that conveys the view's main message."},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
  }
}
